# Skill symlinks into the tool submodules — generated by link-skills.sh, never
# tracked (a tracked symlink dangles when its tool isn't initialized; call/0005).
/.claude/skills/

# Harness doors (host-goal, host-tasks, host-ci) — emitted by
# `host-lifecycle install`, guarded by `install --check`, regenerated by
# bootstrap; machine state like the skill links, never tracked.
/.claude/commands/
/.opencode/commands/

# Generated by `host-lifecycle book` (the canonical publisher); never tracked.
# book.toml stays at the repo root; the source and built HTML live under mdBook/
# (mdBook/src + mdBook/out), so docs/ is free for a project's authored content.
/book.toml
/mdBook/

# Materialized Where room: bare stores and worktrees under software/<name>/.
# The host commits the .host-software recipe; the trees are local, rebuilt by
# host-lifecycle software --materialize, never tracked.
/software/

# The local environment fingerprint: this machine's state, never shared.
.host-envhash

# Local-only tool repo: the formality-check driver has no remote, so the host
# records no gitlink it could not fetch.
tools/formality-check/

# Generated skill links: recreated by link-skills.sh after materialization, so a
# fresh clone that has not materialized the tools carries no dangling symlink.
/.claude/skills/*

# Project-local tool installs: fetched by tools/install-tools.sh at the pinned
# versions in .env, verified by sha256, never committed.
/.host-tools/
.host-goal
